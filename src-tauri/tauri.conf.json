{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anchovy Player",
  "version": "0.1.0",
  "identifier": "com.anchovy.player",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anchovy Player",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "icons/128x128.png": "drag-icon.png"
    }
  }
}
